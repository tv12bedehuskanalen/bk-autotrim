{
  "name": "bk-autotrim",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "verify:release": "node scripts/verify-release.cjs",
    "build:media": "bash scripts/build-media.sh",
    "check": "node scripts/check.cjs",
    "test:media": "node --test test/integration/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "no.bk.autotrim",
    "productName": "BK Autotrim",
    "files": [
      "desktop/**",
      "lib/**",
      "renderer/**",
      "assets/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "artifactName": "BK-Autotrim-${version}-darwin-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "BK-Autotrim-${version}-win32-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "BK-Autotrim-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "media"
      },
      {
        "from": "vendor/licenses",
        "to": "media-licenses"
      }
    ],
    "icon": "assets/icon.png"
  },
  "description": "Klipping og kringkastingseksport for BK",
  "author": "Bedehuskanalen",
  "license": "GPL-3.0-or-later"
}
